{
  "name": "thought-loom",
  "private": true,
  "type": "module",
  "workspaces": ["apps/web"],
  "scripts": {
    "test": "bun test",
    "test:opencode": "bun --no-env-file run tests/opencode/fixture.ts",
    "typecheck": "tsc --noEmit",
    "daemon": "bun run src/daemon/main.ts",
    "api": "bun run scripts/api.ts",
    "demo": "bun run scripts/demo.ts",
    "demo:search": "bun --no-env-file test tests/agentic-search-http-walkthrough.test.ts tests/agentic-search-process-resume.test.ts",
    "build:spellfix": "bash scripts/build-spellfix.sh",
    "web:dev": "bun --no-env-file run --filter @thoughtloom/web dev",
    "web:build": "bun --no-env-file run --filter @thoughtloom/web build",
    "web:start": "bun --no-env-file run --filter @thoughtloom/web start",
    "web:typecheck": "bun --no-env-file run --filter @thoughtloom/web typecheck",
    "web:test": "bun --no-env-file test tests/web-*.test.ts",
    "web:test:runtime": "bun --no-env-file apps/web/tests/foundation.runtime.ts",
    "web:test:integration": "bun --no-env-file apps/web/tests/integration.bootstrap.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/mdast": "4.0.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@opencode/client": "2.2.5",
    "hono": "4.13.16",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "sharp": "0.35.5"
  }
}
